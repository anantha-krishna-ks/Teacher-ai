# Optional: override the backend without editing src/config.js.
# Copy this file to `.env` (or `.env.local`) and uncomment a line.

# Switch to the hosted backend:
# VITE_BACKEND=hosted

# ...or point at any custom base URL (wins over VITE_BACKEND):
# VITE_API_BASE=https://ailevate-poc.excelsoftcorp.com/aiapps/avatarchatbot
